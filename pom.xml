<?xml version="1.0" encoding="UTF-8"?>

<!--
    手写 Java 教程主线。

    这里不使用 Spring Boot 和 Spring AI，
    目的是忠实学习原 Python 教程中的底层机制。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.learn</groupId>
    <artifactId>manual-agent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- 使用你当前已经掌握的 Java 21 语法。 -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- 统一源码和控制台文本的编码。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 手写版直接使用 Anthropic Java SDK 调用百炼兼容接口。 -->
        <anthropic-java.version>2.49.0</anthropic-java.version>

        <!-- 官方 MCP Java SDK 的版本由下面的 BOM 统一管理。 -->
        <mcp-java.version>2.0.0</mcp-java.version>

        <!--
            SKILL.md 的 frontmatter 使用 YAML。
            与 Anthropic SDK 当前依赖的 Jackson 版本对齐，避免组件版本混用。
        -->
        <jackson-yaml.version>2.19.4</jackson-yaml.version>

        <!-- 统一手写 Agent 的运行期诊断日志版本。 -->
        <slf4j.version>2.0.18</slf4j.version>

        <!-- OpenTelemetry API 由业务代码读取当前 Span 并补充动态名称。 -->
        <opentelemetry.version>1.64.0</opentelemetry.version>

        <!-- 注解版本与本地使用的 OpenTelemetry Java Agent 版本保持一致。 -->
        <opentelemetry-instrumentation.version>2.30.0</opentelemetry-instrumentation.version>

        <!-- 使用成熟的双路输出流，同时保留终端显示并保存本次会话文本。 -->
        <commons-io.version>2.22.0</commons-io.version>

        <!-- SQLite 仅用于本地 Session 持久化，不引入 ORM 或连接池。 -->
        <sqlite-jdbc.version>3.46.1.0</sqlite-jdbc.version>

        <!-- 固定 JUnit 5 正式版，验证并发调度契约。 -->
        <junit.version>5.14.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                官方 MCP SDK BOM 统一管理 mcp-core 和 JSON 实现的版本，
                避免分别升级 SDK 模块后产生版本不一致。
            -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-java.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-java.version}</version>
        </dependency>

        <!-- MCP 核心协议、stdio transport 和同步客户端。 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
        </dependency>

        <!--
            项目现有代码使用 Jackson 2，
            因此选择官方 Jackson 2 JSON binding，不引入 Jackson 3 聚合模块。
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
        </dependency>

        <!-- 业务代码只依赖日志门面，不绑定具体输出方式。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- CLI 运行时使用轻量控制台日志实现。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Java Agent 启动时会把 API 调用接入真实 OpenTelemetry SDK。 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>

        <!-- @WithSpan 用于声明 Agent、LLM 和 Tool 的方法级 Span。 -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-instrumentation-annotations</artifactId>
            <version>${opentelemetry-instrumentation.version}</version>
        </dependency>

        <!-- TeeOutputStream 只负责 stdout 分流，不承载 Trace 语义。 -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

        <!-- SQLite JDBC 驱动由 SessionStore 直接通过 JDBC 使用。 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <!--
            解析 SKILL.md 开头的 YAML frontmatter。
            jackson-databind 负责对象映射，本模块负责识别 YAML 语法。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson-yaml.version}</version>
        </dependency>

        <!-- 测试范围只引入 JUnit Jupiter，不进入应用运行期。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 固定 Harbor launcher 读取的 self-contained JAR 文件名。 -->
        <finalName>quillith</finalName>

        <plugins>
            <!-- 明确要求 Maven 使用 Java 21 编译。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- 固定正式版 Surefire，确保 Maven 通过 JUnit Platform 发现测试。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>

            <!-- 让 Harbor Trial 只需 java -jar，不再管理运行期 classpath。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 不生成 dependency-reduced-pom，避免构建改写项目依赖描述。 -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.learn.agent.manual.ManualAgentApplication</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
