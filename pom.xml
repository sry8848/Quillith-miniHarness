<?xml version="1.0" encoding="UTF-8"?>

<!--
    手写 Java 教程主线。

    这里不使用 Spring Boot 和 Spring AI，
    目的是忠实学习原 Python 教程中的底层机制。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.learn</groupId>
    <artifactId>manual-agent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- 使用你当前已经掌握的 Java 21 语法。 -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- 统一源码和控制台文本的编码。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 手写版直接使用 Anthropic Java SDK 调用百炼兼容接口。 -->
        <anthropic-java.version>2.49.0</anthropic-java.version>

        <!-- 统一手写 Agent 的运行期诊断日志版本。 -->
        <slf4j.version>2.0.18</slf4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-java.version}</version>
        </dependency>

        <!-- 业务代码只依赖日志门面，不绑定具体输出方式。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- CLI 运行时使用轻量控制台日志实现。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 明确要求 Maven 使用 Java 21 编译。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>

</project>
